<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO">
    <Properties>
        <property name="time">%d{YYYY-MM-dd HH:mm:ss.SSS}</property>
        <property name="elk_split">|+|</property>
        <property name="custom_split">|</property>

        <!--
            ?щ궡(?랁삊?곹샇湲덉쑖) ?먮낯 ?ㅼ젙 - ?먯뇙留?WAS???덈? 寃쎈줈.
            ?꾨옒 濡쒖뺄 媛쒕컻????以꾩쓣 二쇱꽍 泥섎━?섍퀬 ????以꾩쓣 ?섏궡由곕떎.

            <property name="FRAMEWORK_LOG_PATH">/home/mfpobimx/architecture/proto/was/mpco/logs/fw/mp/application</property>
            <property name="SERVICE_LOG_PATH">/home/mfpobimx/architecture/proto/was/mpco/logs/fw/mp/service</property>
        -->

        <!--
            濡쒖뺄 媛쒕컻 PC??- pdmg-jwt/logs ?섏쐞???④릿??
            ?곷? 寃쎈줈???꾨줈?몄뒪???묒뾽 ?붾젆?곕━ 湲곗??대?濡?bootRun(?묒뾽 ?붾젆?곕━=?꾨줈?앺듃 猷⑦듃)?먯꽌留?
            ?섎룄???꾩튂???볦씤?? WAS??WAR濡??щ┫ ?뚮뒗 ?덈? 寃쎈줈瑜??⑥빞 ?쒕떎.
        -->
        <property name="FRAMEWORK_LOG_PATH">logs/application</property>
        <property name="SERVICE_LOG_PATH">logs/service</property>

        <property name="CORE_HEADER">%X{guid} ${elk_split} %X{userId} ${elk_split} %X{serviceId} ${elk_split} %X{ip} ${elk_split} - ${elk_split}</property>
        <property name="BIZ_HEADER">%X{guid} ${elk_split} %X{userId} ${elk_split} %X{serviceId} ${elk_split} %X{ip} ${elk_split} - ${elk_split}</property>
        <property name="IO_HEADER">%X{guid} ${elk_split} %X{userId} ${elk_split} %X{serviceId} ${elk_split} %X{ip} ${elk_split} - ${elk_split}</property>
        <property name="SQL_HEADER">%X{guid} ${elk_split} %X{userId} ${elk_split} %X{serviceId} ${elk_split} %X{ip} ${elk_split} %X{sqlId} ${elk_split}</property>
        <property name="IF_HEADER">%X{guid} ${elk_split} %X{userId} ${elk_split} %X{serviceId} ${elk_split} %X{ip} ${elk_split} %X{ifId} ${elk_split}</property>
        <property name="ERR_HEADER">%X{guid} ${elk_split} %X{userId} ${elk_split} %X{serviceId} ${elk_split} %X{ip} ${elk_split} %X{errCode} ${elk_split}</property>

        <!-- CUSTOM Default -->
        <!--
            %d : 濡쒓렇??湲곕줉?쒓컙??異쒕젰
            %p : 濡쒓퉭 ?덈꺼??異쒕젰, %F : 濡쒓퉭??諛쒖깮???꾨줈洹몃옩 ?뚯씪紐낆쓣 異쒕젰
            %M : 濡쒓퉭??諛쒖깮??硫붿냼?쒖쓽 ?대쫫??異쒕젰, %l : 濡쒓퉭??諛쒖깮???몄텧吏???뺣낫瑜?異쒕젰
            %L : 濡쒓퉭??諛쒖깮???몄텧吏???쇱씤 ?섎? 異쒕젰, %t : 濡쒓퉭??諛쒖깮??Thread 紐낆쓣 異쒕젰
            %c : 濡쒓퉭??諛쒖깮??移댄뀒怨좊━瑜?異쒕젰, %C : 濡쒓퉭??諛쒖깮???대옒??紐낆쓣 異쒕젰
            %n : 以꾨컮轅?
            %m : 濡쒓렇 硫붿떆吏瑜?異쒕젰
            %% : % 異쒕젰, %r : ?댄뵆由ъ??댁뀡???쒖옉 ?댄썑遺??濡쒓퉭??諛쒖깮???쒖젏源뚯????쒓컙(ms)??異쒕젰
        -->
        <property name="CORE_CUSTOM">[${time}] [%-5p] [%C.%M] %replace{%m}{\n}{&#x2028;}%n</property>
        <property name="BIZ_CUSTOM">[${time}] [%-5p] [%C.%M:%L] %replace{%m}{\n}{&#x2028;}%n</property>
        <!-- <property name="SQL_CUSTOM">[${time}] [%-5p] %replace{%m}{\n}{&#x2028;}%n</property> -->
        <property name="SQL_CUSTOM">[${time}] [%-5p] %msg%n</property>
        <property name="IO_CUSTOM">[${time}] [%-5p] %replace{%m}{\n}{&#x2028;}%n</property>
        <property name="IF_CUSTOM">[${time}] [%-5p] %replace{%m}{\n}{&#x2028;}%n</property>
        <property name="ERR_CUSTOM">[${time}] [%-5p] [%C.%M:%L] %replace{%m}{\n}{&#x2028;}%n</property>
        <property name="MONITOR_CUSTOM">[${time}] [%-5p] [%C.%M:%L] %replace{%m}{\n}{&#x2028;}%n</property>

        <!-- PATTERN -->
        <!-- CORE -->
        <property name="CORE_LOG_PATTERN">[ CORE ]${elk_split} ${CORE_HEADER} ${CORE_CUSTOM}</property>
        <!-- BIZ -->
        <property name="BIZ_LOG_PATTERN">[ BIZ ]${elk_split} ${BIZ_HEADER} ${BIZ_CUSTOM}</property>
        <!-- SQL -->
        <property name="SQL_LOG_PATTERN">[ SQL ]${elk_split} ${SQL_HEADER} ${SQL_CUSTOM}</property>
        <!-- IO -->
        <property name="IO_LOG_PATTERN">[ IO ]${elk_split} ${IO_HEADER} ${IO_CUSTOM}</property>
        <!-- IF -->
        <property name="IF_LOG_PATTERN">[ IF ]${elk_split} ${IF_HEADER} ${IF_CUSTOM}</property>
        <!-- ERR -->
        <property name="ERR_LOG_PATTERN">[ ERR ]${elk_split} ${ERR_HEADER} ${ERR_CUSTOM}</property>
        <!-- MONITOR -->
        <property name="MONITOR_LOG_PATTERN">[ MONITOR ]${elk_split}-${elk_split}-${elk_split}-${elk_split}-${elk_split}-${elk_split}${MONITOR_CUSTOM}</property>
    </Properties>

    <Appenders>
        <Console name="CORE">
            <PatternLayout pattern="${CORE_LOG_PATTERN}" charset="UTF-8" disableAnsi="false"/>
        </Console>
        <Console name="IO">
            <PatternLayout pattern="${IO_LOG_PATTERN}" charset="UTF-8" disableAnsi="false"/>
        </Console>
        <Console name="IF">
            <PatternLayout pattern="${IF_LOG_PATTERN}" charset="UTF-8" disableAnsi="false"/>
        </Console>
        <Console name="BIZ">
            <PatternLayout pattern="${BIZ_LOG_PATTERN}" charset="UTF-8" disableAnsi="false"/>
        </Console>
        <Console name="SQL">
            <PatternLayout pattern="${SQL_LOG_PATTERN}" charset="UTF-8" disableAnsi="false"/>
        </Console>
        <Console name="ERR">
            <PatternLayout pattern="${ERR_LOG_PATTERN}" charset="UTF-8" disableAnsi="false"/>
        </Console>
        <Console name="MONITOR">
            <PatternLayout pattern="${MONITOR_LOG_PATTERN}" charset="UTF-8" disableAnsi="false"/>
        </Console>

        <RollingFile name="FRAMEWORK_LOG_FILE"
                     fileName="${FRAMEWORK_LOG_PATH}/pk_framework.log"
                     filePattern="${FRAMEWORK_LOG_PATH}/pk_framework_%d{yyyy-MM-dd}.log.gz">
            <PatternLayout pattern="${CORE_LOG_PATTERN}" charset="UTF-8"/>
            <Policies>
                <!-- ?섎（ 1??濡ㅻ쭅 -->
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="500MB"/>
            </Policies>
            <DefaultRolloverStrategy>
                <Delete basePath="${FRAMEWORK_LOG_PATH}">
                    <IfFileName glob="*.log.gz"/>
                    <IfLastModified age="30d"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <RollingFile name="SERVICE_LOG_FILE"
                     fileName="${SERVICE_LOG_PATH}/pk_service.log"
                     filePattern="${SERVICE_LOG_PATH}/pk_service_%d{yyyy-MM-dd}.log.gz">
            <PatternLayout pattern="${BIZ_LOG_PATTERN}" charset="UTF-8"/>
            <Policies>
                <!-- ?섎（ 1??濡ㅻ쭅 -->
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="500MB"/>
            </Policies>
            <DefaultRolloverStrategy>
                <Delete basePath="${SERVICE_LOG_PATH}">
                    <IfFileName glob="*.log.gz"/>
                    <IfLastModified age="30d"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="CORE"/>
            <AppenderRef ref="FRAMEWORK_LOG_FILE"/>
        </Root>

        <Logger name="org.springframework" level="info" additivity="false">
            <AppenderRef ref="CORE"/>
            <AppenderRef ref="FRAMEWORK_LOG_FILE"/>
        </Logger>

        <Logger name="org.apache" level="off" additivity="false">
            <AppenderRef ref="CORE"/>
            <AppenderRef ref="FRAMEWORK_LOG_FILE"/>
        </Logger>

        <Logger name="nhnis.fw" level="info" additivity="false">
            <AppenderRef ref="CORE"/>
            <AppenderRef ref="FRAMEWORK_LOG_FILE"/>
        </Logger>

        <Logger name="nhnis.fw.commons.interceptor" level="info" additivity="false">
            <AppenderRef ref="CORE"/>
            <AppenderRef ref="FRAMEWORK_LOG_FILE"/>
        </Logger>

        <Logger name="nhnis.fw.commons.filter" level="info" additivity="false">
            <AppenderRef ref="CORE"/>
            <AppenderRef ref="FRAMEWORK_LOG_FILE"/>
        </Logger>

        <Logger name="nhnis.mg" level="info" additivity="false">
            <AppenderRef ref="BIZ"/>
            <AppenderRef ref="SERVICE_LOG_FILE"/>
            <AppenderRef ref="FRAMEWORK_LOG_FILE"/>
        </Logger>

        <Logger name="nhnis.mg.jw.a.config.MybatisLogInterceptor" level="debug" additivity="false">
            <AppenderRef ref="SQL"/>
        </Logger>

        <Logger name="nhnis.mg.jw.a.entry.aspect" level="info" additivity="false">
            <AppenderRef ref="BIZ"/>
            <AppenderRef ref="SERVICE_LOG_FILE"/>
        </Logger>

        <Logger name="nhnis.mg.jw.a.entry.aspect.BizPrePostAspect" level="info" additivity="false">
            <AppenderRef ref="BIZ"/>
            <AppenderRef ref="SERVICE_LOG_FILE"/>
        </Logger>
        <!-- LOG4JDBC -->
        <Logger name="jdbc.sqlonly" level="off" additivity="false">
            <AppenderRef ref="FRAMEWORK_LOG_FILE"/>
            <AppenderRef ref="SERVICE_LOG_FILE"/>
            <AppenderRef ref="SQL"/>
        </Logger>

        <Logger name="jdbc.sqltiming" level="debug" additivity="false">
            <AppenderRef ref="FRAMEWORK_LOG_FILE"/>
            <AppenderRef ref="SERVICE_LOG_FILE"/>
            <AppenderRef ref="SQL"/>
        </Logger>

        <Logger name="jdbc.resultsettable" level="off" additivity="false">
            <AppenderRef ref="SQL"/>
        </Logger>

        <Logger name="jdbc.audit" level="off" additivity="false">
            <AppenderRef ref="SQL"/>
        </Logger>

        <Logger name="jdbc.resultset" level="off" additivity="false">
            <AppenderRef ref="SQL"/>
        </Logger>

        <Logger name="jdbc.connection" level="off" additivity="false">
            <AppenderRef ref="SQL"/>
        </Logger>

        <!-- Hikari keepalive/isValid + log4jdbc methodReturned noise -->
        <Logger name="net.sf.log4jdbc" level="warn" additivity="false">
            <AppenderRef ref="CORE"/>
            <AppenderRef ref="FRAMEWORK_LOG_FILE"/>
        </Logger>
        <Logger name="com.zaxxer.hikari" level="warn" additivity="false">
            <AppenderRef ref="CORE"/>
            <AppenderRef ref="FRAMEWORK_LOG_FILE"/>
        </Logger>
    </Loggers>
</Configuration>

